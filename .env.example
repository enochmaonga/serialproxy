# Server Configuration
PORT=5002
NODE_ENV=development

# MongoDB Connection String
# Replace with your new MongoDB Atlas cluster URI or local MongoDB URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kcc?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kcc?retryWrites=true&w=majority

# JWT & Authentication Secrets
JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Allowed Frontend Origins (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://serialmanagement.vercel.app
